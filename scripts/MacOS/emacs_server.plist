<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>emacs_server</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/opt/emacs-plus@30/bin/emacs</string>
      <string>--fg-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Mark the daemon user-interactive so launchd doesn't deprioritize/throttle
         it in the background. Together with `defaults write org.gnu.Emacs
         NSAppSleepDisabled -bool YES` (App Nap off), this keeps focus-change
         events prompt so the regain-focus flash fires without a 1-2s lag. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/emacs_server.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/emacs_server.stderr.log</string>
  </dict>
</plist>
